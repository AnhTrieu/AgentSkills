{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "mode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "init",
            "adopt",
            "reorganize"
          ]
        },
        "layout": {
          "enum": [
            "single",
            "multi_component"
          ]
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "language",
          "profile",
          "package_manager"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "minLength": 1
          },
          "profile": {
            "type": "string",
            "minLength": 1
          },
          "package_manager": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "import_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "python_version": {
            "type": "string",
            "pattern": "^3\\.(1[1-9]|[2-9][0-9])$"
          },
          "node_version": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+){0,2}$"
          },
          "manager_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.]+)?$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "runtime_deps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dev_deps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "npm_dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "npm_dev_dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "commands": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "install",
                "ci_install",
                "lock",
                "lint",
                "format_check",
                "format_fix",
                "typecheck",
                "test",
                "build",
                "dev",
                "smoke"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "argv"
              ],
              "additionalProperties": false,
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "timeout": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1800
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "prd",
              "sdd",
              "adr",
              "readme",
              "other"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "reason",
          "source"
        ],
        "properties": {
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "inferred": {
            "type": "boolean"
          }
        }
      }
    },
    "editor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "layout": {
          "enum": [
            "single_folder",
            "multi_root"
          ]
        },
        "extension_installation": {
          "enum": [
            "recommend_only",
            "install"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "harnesses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude_code",
          "codex",
          "antigravity"
        ]
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initialize": {
          "type": "boolean"
        },
        "initial_branch": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_/-]*$"
        },
        "commit": {
          "enum": [
            "never",
            "new_repo_after_verification",
            "after_verification"
          ]
        },
        "additional_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "none",
            "github",
            "gitlab"
          ]
        },
        "runner": {
          "enum": [
            "hosted",
            "self_hosted_macos"
          ]
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "link",
            "create"
          ]
        },
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "private",
            "public"
          ]
        },
        "push": {
          "type": "boolean"
        }
      }
    },
    "infrastructure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "devcontainer": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "provider": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "requirement",
          "reason",
          "validation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "requirement": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content",
          "deviation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "deviation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "destination",
          "reason"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
